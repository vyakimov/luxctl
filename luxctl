# --- JSON input --------------------------------------------------------------


def read_json_input(args: argparse.Namespace) -> dict[str, Any] | None:
    if args.input_json and args.input:
        raise CliError("invalid_arguments", "Provide either --input-json or --input, not both")
    if args.input_json is None and args.input is None:
        return None

    if args.input_json is not None:
        raw = args.input_json
    else:
        if args.input == "-":
            raw = sys.stdin.read()
        else:
            try:
                raw = Path(args.input).read_text(encoding="utf-8")
            except OSError as exc:
                raise CliError("invalid_arguments", "Could not read input file", {"path": args.input, "reason": str(exc)}) from exc
    try:
        doc = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise CliError("invalid_arguments", "Input JSON is not valid JSON", {"reason": str(exc)}) from exc
    if not isinstance(doc, dict):
        raise CliError("invalid_arguments", "Input JSON must be a top-level object")
    return doc


def require_object(value: Any, field_name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise CliError("invalid_arguments", f"{field_name} must be an object")
    return value


def require_string_list(value: Any, field_name: str) -> list[str]:
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(item, str) and item.strip() for item in value):
        raise CliError("invalid_arguments", f"{field_name} must be a list of non-empty strings")
    return value


def validate_keys(value: dict[str, Any], allowed_keys: set[str], field_name: str) -> None:
    unknown = sorted(set(value) - allowed_keys)
    if unknown:
        raise CliError("invalid_arguments", f"{field_name} contains unknown keys", {"field": field_name, "unknown_keys": unknown})


# --- write execution ---------------------------------------------------------


def execute_light_writes(
    *,
    action: str,
    client: HueClient,
    targets: list[dict[str, Any]],
    payload: dict[str, Any],
    dry_run: bool,
    verbose: bool = False,
    extra_result: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Apply one payload across targets and report the outcome, not the state.

    The default response is a summary plus any failures. Per-target echoes are
    only included with --verbose, because on a successful write they carry no
    information the summary does not already give.
    """
    result = dict(extra_result or {})

    if dry_run:
        result.update(
            {
                "payload": payload,
                "summary": {
                    "target_count": len(targets),
                    "success_count": 0,
                    "failure_count": 0,
                    "dry_run": True,
                },
            }
        )
        if verbose:
            result["targets"] = [ref_of(light) for light in targets]
        return success(action, result, get_meta(client, dry_run=True))

    writes: list[dict[str, Any]] = []
    failures: list[dict[str, Any]] = []
    success_count = 0
    for light in targets:
        try:
            bridge_response = client.request("PUT", f"resource/light/{light['id']}", payload)
            writes.append({"target": ref_of(light), "ok": True, "bridge_response": bridge_response})
            success_count += 1
        except CliError as exc:
            entry = {
                "target": ref_of(light),
                "ok": False,
                "error": {"type": exc.error_type, "message": exc.message, "details": exc.details},
            }
            writes.append(entry)
            # Failures always surface, regardless of verbosity: they are the one
            # case the caller has to act on.
            failures.append({"target": ref_of(light), "error": entry["error"]})

    result.update(
        {
            "applied": payload,
            "summary": {
                "target_count": len(targets),
                "success_count": success_count,
                "failure_count": len(failures),
                "dry_run": False,
            },
        }
    )
    if failures:
        result["failures"] = failures
    if verbose:
        result["writes"] = writes
    return success(action, result, get_meta(client))


# --- handlers ----------------------------------------------------------------


def selector_values(args: argparse.Namespace) -> tuple[str | None, str | None, str | None]:
    return (getattr(args, "ref", None), getattr(args, "name", None), getattr(args, "id", None))


def require_list_intent(args: argparse.Namespace, resource: str, has_filter: bool) -> None:
    """Listing a whole collection has to be asked for explicitly."""
    if getattr(args, "all", False) or has_filter:
        return
    raise CliError(
        "selector_required",
        f"Listing all {resource}s requires --all",
        {
            "resource_type": resource,
            "hint": f"Select one with --ref/--name/--id, filter the list, or pass --all to list every {resource}.",
        },
    )


def validate_get_intent(args: argparse.Namespace) -> None:
    """Check everything that can be checked without talking to the bridge.

    Running this before connecting means a missing selector costs no round
    trip and reports the real problem instead of a config or network error.
    """
    ref, name, item_id = selector_values(args)
    has_selector = bool(ref or name or item_id)
    if args.raw and not has_selector:
        raise CliError(
            "invalid_arguments",
            "--raw requires a selector",
            {"hint": "Raw output is only available for a single resource: pass --ref, --name, or --id."},
        )
    if has_selector:
        return
    has_filter = bool(getattr(args, "room", None)) or getattr(args, "on", None) is not None
    require_list_intent(args, args.resource, has_filter=has_filter)


def handle_get(args: argparse.Namespace, inventory: dict[str, Any], client: HueClient) -> dict[str, Any]:
    action = f"get_{args.resource}"
    ref, name, item_id = selector_values(args)
    has_selector = bool(ref or name or item_id)
    detail, raw = bool(args.detail), bool(args.raw)
    validate_get_intent(args)

    if args.resource == "light":
        records = inventory["lights"]
        if has_selector:
            record = resolve_selector(records, "light", item_id=item_id, item_name=name, item_ref=ref)
            return success(action, {"light": view_light(record, detail, raw)}, get_meta(client, view=view_name(args)))

        room = resolve_optional_room_filter(inventory["rooms"], getattr(args, "room", None))
        if room is not None:
            member_ids = {light["id"] for light in room["lights"]}
            records = [record for record in records if record["id"] in member_ids]
        on_filter = getattr(args, "on", None)
        if on_filter is not None:
            records = [record for record in records if bool(record.get("on")) is on_filter]
        total = len(records)
        if args.count:
            return success(action, {"count": total, "total": total}, get_meta(client, view=view_name(args)))
        if args.limit:
            records = records[: args.limit]
        result = list_result("lights", [view_light(record, detail) for record in records], total=total)
        return enforce_budget(success(action, result, get_meta(client, view=view_name(args))), "lights", args.max_bytes)

    if args.resource == "room":
        records = inventory["rooms"]
        with_lights = bool(getattr(args, "with_lights", False))
        with_scenes = bool(getattr(args, "with_scenes", False))
        if has_selector:
            record = resolve_selector(records, "room", item_id=item_id, item_name=name, item_ref=ref)
            payload = {"room": view_room(record, detail, raw, with_lights, with_scenes)}
            return success(action, payload, get_meta(client, view=view_name(args)))

        total = len(records)
        if args.count:
            return success(action, {"count": total, "total": total}, get_meta(client, view=view_name(args)))
        if args.limit:
            records = records[: args.limit]
        items = [view_room(record, detail, False, with_lights, with_scenes) for record in records]
        result = list_result("rooms", items, total=total)
        return enforce_budget(success(action, result, get_meta(client, view=view_name(args))), "rooms", args.max_bytes)

    records = inventory["scenes"]
    room = resolve_optional_room_filter(inventory["rooms"], getattr(args, "room", None))
    if room is not None:
        records = [record for record in records if record.get("room_id") == room["id"]]
    if has_selector:
        record = resolve_selector(records, "scene", item_id=item_id, item_name=name, item_ref=ref)
        return success(action, {"scene": view_scene(record, detail, raw)}, get_meta(client, view=view_name(args)))

    total = len(records)
    if args.count:
        return success(action, {"count": total, "total": total}, get_meta(client, view=view_name(args)))
    if args.limit:
        records = records[: args.limit]
    result = list_result("scenes", [view_scene(record, detail) for record in records], total=total)
    return enforce_budget(success(action, result, get_meta(client, view=view_name(args))), "scenes", args.max_bytes)


def handle_set_light(args: argparse.Namespace, client: HueClient, inventory: dict[str, Any]) -> dict[str, Any]:
    targets = resolve_light_targets(
        inventory["lights"], ids=args.id, names=args.name, refs=args.ref, select_all=args.all
    )
    payload = build_light_payload(args)
    extra: dict[str, Any] = {}
    if args.all:
        extra["scope"] = "all_lights"
    elif len(targets) == 1:
        extra["target"] = ref_of(targets[0])
    else:
        extra["targets"] = [ref_of(light) for light in targets]
    return execute_light_writes(
        action="set_light",
        client=client,
        targets=targets,
        payload=payload,
        dry_run=args.dry_run,
        verbose=args.verbose,
        extra_result=extra,
    )


def handle_set_room(args: argparse.Namespace, client: HueClient, inventory: dict[str, Any]) -> dict[str, Any]:
    payload = build_light_payload(args)
    ref, name, item_id = selector_values(args)

    if args.all:
        if ref or name or item_id:
            raise CliError("invalid_arguments", "--all cannot be combined with --ref, --name, or --id")
        candidates = lights_in_all_rooms(inventory)
        if not candidates:
            raise CliError("resource_not_found", "No target lights found in any room")
        targets, excluded = partition_excluded(candidates, args.exclude, "all_rooms")
        if not targets:
            raise CliError(
                "invalid_arguments",
                "No target lights remain after exclusions",
                {"scope": "all_rooms", "exclude": args.exclude},
            )
        extra_all: dict[str, Any] = {"scope": "all_rooms", "room_count": len(inventory["rooms"])}
        if excluded:
            extra_all["excluded"] = [ref_of(light) for light in excluded]
        return execute_light_writes(
            action="set_room",
            client=client,
            targets=targets,
            payload=payload,
            dry_run=args.dry_run,
            verbose=args.verbose,
            extra_result=extra_all,
        )

    room = resolve_selector(inventory["rooms"], "room", item_id=item_id, item_name=name, item_ref=ref)
    targets, excluded = partition_excluded(room["lights"], args.exclude, room["ref"])
    if not targets:
        raise CliError(
            "invalid_arguments",
            "No target lights remain after exclusions",
            {"room": room["ref"], "exclude": args.exclude},
        )
    extra: dict[str, Any] = {"room": ref_of(room)}
    if excluded:
        extra["excluded"] = [ref_of(light) for light in excluded]
    return execute_light_writes(
        action="set_room",
        client=client,
        targets=targets,
        payload=payload,
        dry_run=args.dry_run,
        verbose=args.verbose,
        extra_result=extra,
    )


def handle_set_scene(args: argparse.Namespace, client: HueClient, inventory: dict[str, Any]) -> dict[str, Any]:
    room = resolve_optional_room_filter(inventory["rooms"], getattr(args, "room", None))
    scenes = inventory["scenes"]
    if room is not None:
        scenes = [scene for scene in scenes if scene.get("room_id") == room["id"]]
    ref, name, item_id = selector_values(args)
    scene = resolve_selector(scenes, "scene", item_id=item_id, item_name=name, item_ref=ref)
    payload = build_scene_payload(action=args.action, duration_ms=args.duration_ms)
    return apply_scene(client, scene, payload, dry_run=args.dry_run, verbose=args.verbose)


def apply_scene(
    client: HueClient,
    scene: dict[str, Any],
    payload: dict[str, Any],
    *,
    dry_run: bool,
    verbose: bool = False,
) -> dict[str, Any]:
    reference = {"ref": scene["ref"], "name": scene["name"], "room": scene.get("room_ref")}
    if dry_run:
        return success("set_scene", {"scene": reference, "payload": payload}, get_meta(client, dry_run=True))
    response = client.request("PUT", f"resource/scene/{scene['id']}", payload)
    result = {"scene": reference, "applied": payload, "summary": {"ok": True}}
    if verbose:
        result["bridge_response"] = response
    return success("set_scene", result, get_meta(client))


def handle_json_action(doc: dict[str, Any], args: argparse.Namespace, client: HueClient, inventory: dict[str, Any]) -> dict[str, Any]:
    validate_keys(doc, {"action", "targets", "target", "payload", "exclude", "dry_run", "verbose"}, "input")
    action = doc.get("action")
    if not isinstance(action, str) or not action:
        raise CliError("invalid_arguments", "input.action must be a non-empty string")

    if doc.get("dry_run") is not None and args.dry_run:
        raise CliError("invalid_arguments", "dry_run must be specified either in JSON or by --dry-run, not both")
    dry_run = bool(doc.get("dry_run", False) or args.dry_run)
    verbose = bool(doc.get("verbose", False) or args.verbose)

    if action == "set_light":
        targets_doc = require_object(doc.get("targets"), "targets")
        validate_keys(targets_doc, {"ids", "names", "refs", "all"}, "targets")
        select_all = bool(targets_doc.get("all", False))
        targets = resolve_light_targets(
            inventory["lights"],
            ids=require_string_list(targets_doc.get("ids"), "targets.ids"),
            names=require_string_list(targets_doc.get("names"), "targets.names"),
            refs=require_string_list(targets_doc.get("refs"), "targets.refs"),
            select_all=select_all,
        )
        payload = build_light_payload_from_json(require_object(doc.get("payload"), "payload"))
        extra: dict[str, Any] = {"scope": "all_lights"} if select_all else (
            {"target": ref_of(targets[0])} if len(targets) == 1 else {"targets": [ref_of(light) for light in targets]}
        )
        return execute_light_writes(
            action="set_light",
            client=client,
            targets=targets,
            payload=payload,
            dry_run=dry_run,
            verbose=verbose,
            extra_result=extra,
        )

    if action == "set_room":
        target_doc = require_object(doc.get("target"), "target")
        validate_keys(target_doc, {"id", "name", "ref", "all"}, "target")
        payload = build_light_payload_from_json(require_object(doc.get("payload"), "payload"))
        exclude = require_string_list(doc.get("exclude"), "exclude")
        namespace = argparse.Namespace(
            ref=target_doc.get("ref"),
            name=target_doc.get("name"),
            id=target_doc.get("id"),
            all=bool(target_doc.get("all", False)),
            exclude=exclude,
            dry_run=dry_run,
            verbose=verbose,
        )
        # Reuse the flag-mode path so both entry points behave identically.
        if namespace.all:
            if namespace.ref or namespace.name or namespace.id:
                raise CliError("invalid_arguments", "target.all cannot be combined with ref, name, or id")
            candidates = lights_in_all_rooms(inventory)
            if not candidates:
                raise CliError("resource_not_found", "No target lights found in any room")
            targets, excluded = partition_excluded(candidates, exclude, "all_rooms")
            if not targets:
                raise CliError(
                    "invalid_arguments",
                    "No target lights remain after exclusions",
                    {"scope": "all_rooms", "exclude": exclude},
                )
            extra_all: dict[str, Any] = {"scope": "all_rooms", "room_count": len(inventory["rooms"])}
            if excluded:
                extra_all["excluded"] = [ref_of(light) for light in excluded]
            return execute_light_writes(
                action="set_room",
                client=client,
                targets=targets,
                payload=payload,
                dry_run=dry_run,
                verbose=verbose,
                extra_result=extra_all,
            )
        room = resolve_selector(
            inventory["rooms"], "room", item_id=namespace.id, item_name=namespace.name, item_ref=namespace.ref
        )
        targets, excluded = partition_excluded(room["lights"], exclude, room["ref"])
        if not targets:
            raise CliError(
                "invalid_arguments",
                "No target lights remain after exclusions",
                {"room": room["ref"], "exclude": exclude},
            )
        extra_room: dict[str, Any] = {"room": ref_of(room)}
        if excluded:
            extra_room["excluded"] = [ref_of(light) for light in excluded]
        return execute_light_writes(
            action="set_room",
            client=client,
            targets=targets,
            payload=payload,
            dry_run=dry_run,
            verbose=verbose,
            extra_result=extra_room,
        )

    if action == "set_scene":
        target_doc = require_object(doc.get("target"), "target")
        validate_keys(target_doc, {"id", "name", "ref", "room"}, "target")
        payload_doc = require_object(doc.get("payload"), "payload") if doc.get("payload") is not None else {}
        validate_keys(payload_doc, {"action", "duration_ms"}, "payload")
        room = resolve_optional_room_filter(inventory["rooms"], target_doc.get("room"))
        scenes = inventory["scenes"]
        if room is not None:
            scenes = [scene for scene in scenes if scene.get("room_id") == room["id"]]
        scene = resolve_selector(
            scenes, "scene", item_id=target_doc.get("id"), item_name=target_doc.get("name"), item_ref=target_doc.get("ref")
        )
        payload = build_scene_payload(action=payload_doc.get("action", "active"), duration_ms=payload_doc.get("duration_ms"))
        return apply_scene(client, scene, payload, dry_run=dry_run, verbose=verbose)

    raise CliError("invalid_arguments", "Unsupported JSON action", {"action": action})


def build_light_payload_from_json(doc: dict[str, Any]) -> dict[str, Any]:
    validate_keys(doc, {"on", "brightness", "mirek", "xy", "hex"}, "payload")
    return build_light_payload_from_values(
        on=doc.get("on"),
        brightness=doc.get("brightness"),
        mirek=doc.get("mirek"),
        xy=doc.get("xy"),
        hex_value=doc.get("hex"),
    )


def load_runtime_config(args: argparse.Namespace) -> HueClient:
    bridge = args.bridge or os.environ.get("LUXCTL_BRIDGE")
    key = args.key or os.environ.get("LUXCTL_KEY")
    ca_cert = args.ca_cert or os.environ.get("LUXCTL_CA_CERT")
    if not bridge or not key:
        config = load_simple_yaml(Path(args.config).expanduser())
        bridge = bridge or config["bridge"]
        key = key or config["key"]
        ca_cert = ca_cert or config.get("ca_cert")
    return HueClient(
        bridge=bridge,
        key=key,
        connect_timeout=args.connect_timeout,
        read_timeout=args.read_timeout,
        ca_cert=ca_cert,
    )


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    try:
        argv = normalize_global_flags(raw_argv)
        if not argv or "--help" in argv or "-h" in argv:
            print_json(build_help_payload(argv))
            return 0
        if "--version" in argv:
            print_json(success("version", {"version": VERSION}))
            return 0

        parser = build_parser()
        args = parser.parse_args(argv)
        if args.command == "list-actions":
            print_json(list_actions_payload())
            return 0
        if args.command == "schema":
            print_json(schema_payload())
            return 0
        input_doc = read_json_input(args)
        if input_doc is not None:
            if args.command is not None:
                raise CliError("invalid_arguments", "JSON input mode cannot be combined with command arguments")
            client = load_runtime_config(args)
            inventory = fetch_inventory(client, **plan_fetch(args, input_doc))
            print_json(handle_json_action(input_doc, args, client, inventory))
            return 0
        if not args.command:
            raise CliError("invalid_arguments", "A command is required")
        if args.command in {"get", "set"} and args.resource not in {"light", "room", "scene"}:
            raise CliError("invalid_arguments", f"A {args.command} resource is required: light, room, or scene")
        if args.command == "get":
            # Argument-only checks run before connecting, so a missing selector
            # costs no round trip and reports the real problem.
            validate_get_intent(args)
        client = load_runtime_config(args)
        inventory = fetch_inventory(client, **plan_fetch(args, None))
        if args.command == "get":
            print_json(handle_get(args, inventory, client))
            return 0
        if args.command == "set":
            if args.resource == "light":
                print_json(handle_set_light(args, client, inventory))
                return 0
            if args.resource == "room":
                print_json(handle_set_room(args, client, inventory))
                return 0
            print_json(handle_set_scene(args, client, inventory))
            return 0
        raise CliError("invalid_arguments", "Unknown command")
    except CliError as exc:
        print_json(failure(args_to_action(raw_argv), exc.error_type, exc.message, exc.details))
        return 1
    except Exception as exc:  # the JSON-only contract must hold even for bugs
        print_json(failure(args_to_action(raw_argv), "internal_error", f"{type(exc).__name__}: {exc}"))
        return 1


def args_to_action(argv: list[str]) -> str:
    value_flags = GLOBAL_VALUE_FLAGS
    boolean_flags = GLOBAL_BOOLEAN_FLAGS
    tokens: list[str] = []
    idx = 0
    while idx < len(argv):
        token = argv[idx]
        if token in value_flags:
            idx += 2
            continue
        if token in boolean_flags or token.startswith("-"):
            idx += 1
            continue
        tokens.append(token)
        idx += 1
    if not tokens:
        if "--input-json" in argv or "--input" in argv:
            return "json_input"
        if "--version" in argv:
            return "version"
        return "help"
    if len(tokens) >= 2 and tokens[0] in {"get", "set"}:
        return f"{tokens[0]}_{tokens[1]}"
    return tokens[0].replace("-", "_")


if __name__ == "__main__":
    raise SystemExit(main())
