class CliError(Exception):
    def __init__(self, error_type: str, message: str, details: dict[str, Any] | None = None):
        super().__init__(message)
        self.error_type = error_type
        self.message = message
        self.details = details or {}


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise CliError("invalid_arguments", message)

    def exit(self, status: int = 0, message: str | None = None) -> None:
        if status:
            raise CliError("invalid_arguments", (message or "argument parsing failed").strip())
        raise SystemExit(status)


def success(action: str, result: dict[str, Any] | None = None, meta: dict[str, Any] | None = None) -> dict[str, Any]:
    return {
        "ok": True,
        "action": action,
        "result": result or {},
        "meta": meta or {},
    }


def failure(action: str, err_type: str, message: str, details: dict[str, Any] | None = None) -> dict[str, Any]:
    return {
        "ok": False,
        "action": action,
        "error": {
            "type": err_type,
            "message": message,
            "details": details or {},
        },
    }


def encode(payload: Any) -> str:
    return json.dumps(payload, separators=(",", ":"), sort_keys=True)


def print_json(payload: dict[str, Any]) -> None:
    print(encode(payload))


def clamp_detail(value: Any) -> Any:
    """Keep an echoed bridge payload from dominating the response."""
    text = value if isinstance(value, str) else encode(value)
    if len(text) <= MAX_ERROR_DETAIL_CHARS:
        return value
    return {
        "truncated": True,
        "original_chars": len(text),
        "preview": text[:MAX_ERROR_DETAIL_CHARS],
    }


def parse_bool(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"true", "1", "yes", "on"}:
            return True
        if normalized in {"false", "0", "no", "off"}:
            return False
    raise CliError("invalid_arguments", "expected boolean value: true/false", {"value": value})


def parse_number(value: Any, field_name: str) -> float:
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return float(value)
    if isinstance(value, str):
        try:
            return float(value)
        except ValueError:
            pass
    raise CliError("invalid_arguments", f"{field_name} must be a number", {"value": value})


def parse_positive_float(value: Any) -> float:
    number = parse_number(value, "timeout")
    if number <= 0:
        raise CliError("invalid_arguments", "timeout must be greater than 0", {"value": value})
    return number


def parse_non_negative_int(value: Any) -> int:
    number = parse_number(value, "value")
    if not number.is_integer() or number < 0:
        raise CliError("invalid_arguments", "value must be a non-negative integer", {"value": value})
    return int(number)


def parse_positive_int(value: Any) -> int:
    number = parse_non_negative_int(value)
    if number == 0:
        raise CliError("invalid_arguments", "value must be greater than 0", {"value": value})
    return number


def parse_brightness(value: Any) -> float:
    number = parse_number(value, "brightness")
    if number < 0 or number > 100:
        raise CliError("invalid_arguments", "brightness must be between 0 and 100", {"value": value})
    return round(number, 4)


def parse_mirek(value: Any) -> int:
    number = parse_number(value, "mirek")
    if not number.is_integer():
        raise CliError("invalid_arguments", "mirek must be an integer", {"value": value})
    mirek = int(number)
    if mirek < 153 or mirek > 500:
        raise CliError("invalid_arguments", "mirek must be between 153 and 500", {"value": value})
    return mirek


def parse_xy(values: Any) -> tuple[float, float]:
    if not isinstance(values, (list, tuple)) or len(values) != 2:
        raise CliError("invalid_arguments", "xy requires exactly two numbers")
    x = parse_number(values[0], "xy[0]")
    y = parse_number(values[1], "xy[1]")
    if not (0 <= x <= 1 and 0 <= y <= 1):
        raise CliError("invalid_arguments", "xy values must be between 0 and 1", {"xy": [x, y]})
    return (round(x, 6), round(y, 6))


def normalize_name(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip().casefold()


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", (value or "").casefold()).strip("-")
    return slug or "unnamed"


def assign_refs(items: list[dict[str, Any]], qualifier: Any = None) -> dict[str, str]:
    """Map each item id to a short semantic ref.

    A ref is the slugified name when that is unique. Colliding names are
    qualified by their room ('kitchen/lamp'), and the pathological case of a
    duplicate name inside one room falls back to a numeric suffix. Suffixes are
    assigned in uuid order so they are stable for a given bridge state.
    """
    by_slug: dict[str, list[dict[str, Any]]] = {}
    for item in items:
        by_slug.setdefault(slugify(item.get("name", "")), []).append(item)

    refs: dict[str, str] = {}
    for slug, group in by_slug.items():
        if len(group) == 1:
            refs[group[0]["id"]] = slug
            continue
        by_qualified: dict[str, list[dict[str, Any]]] = {}
        for item in group:
            room = qualifier(item) if qualifier else None
            key = f"{slugify(room)}/{slug}" if room else slug
            by_qualified.setdefault(key, []).append(item)
        for key, subgroup in by_qualified.items():
            if len(subgroup) == 1:
                refs[subgroup[0]["id"]] = key
                continue
            for index, item in enumerate(sorted(subgroup, key=lambda entry: entry["id"]), start=1):
                refs[item["id"]] = key if index == 1 else f"{key}-{index}"
    return refs


def load_simple_yaml(path: Path) -> dict[str, str]:
    if not path.exists():
        raise CliError("config_not_found", "Hue config file not found", {"path": str(path)})
    data: dict[str, str] = {}
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" not in line:
            raise CliError("config_invalid", "Invalid config line", {"line": raw_line, "path": str(path)})
        key, _, value = line.partition(":")
        data[key.strip()] = value.strip().strip('"').strip("'")
    for required in ("bridge", "key"):
        if not data.get(required):
            raise CliError("config_invalid", f"Config missing '{required}'", {"path": str(path)})
    return data


def build_ssl_context(ca_cert: str | None) -> ssl.SSLContext:
    if ca_cert:
        try:
            context = ssl.create_default_context(cafile=str(Path(ca_cert).expanduser()))
        except (OSError, ssl.SSLError) as exc:
            raise CliError("config_invalid", "Could not load CA certificate", {"ca_cert": ca_cert, "reason": str(exc)}) from exc
        # Hue bridge certificates carry the bridge ID as their common name, not
        # the bridge IP, so the certificate chain is verified but the hostname
        # cannot be.
        context.check_hostname = False
        return context
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    return context


class HueClient:
    def __init__(self, bridge: str, key: str, connect_timeout: float, read_timeout: float, ca_cert: str | None = None):
        self.bridge = bridge
        self.key = key
        self.connect_timeout = connect_timeout
        self.read_timeout = read_timeout
        self.ssl_context = build_ssl_context(ca_cert)

    def request(self, method: str, path: str, payload: dict[str, Any] | None = None) -> dict[str, Any]:
        body = None if payload is None else json.dumps(payload).encode("utf-8")
        headers = {
            "hue-application-key": self.key,
            "Accept": "application/json",
        }
        if body is not None:
            headers["Content-Type"] = "application/json"

        conn = http.client.HTTPSConnection(
            self.bridge,
            timeout=self.connect_timeout,
            context=self.ssl_context,
        )
        try:
            conn.request(method, f"/{API_VERSION}/{path.lstrip('/')}", body=body, headers=headers)
            if conn.sock is not None:
                conn.sock.settimeout(self.read_timeout)
            response = conn.getresponse()
            raw = response.read()
        except socket.timeout as exc:
            raise CliError("timeout", "Hue bridge request timed out", {"bridge": self.bridge}) from exc
        except ssl.SSLCertVerificationError as exc:
            raise CliError(
                "tls_verification_failed",
                "Hue bridge TLS certificate could not be verified against the configured CA certificate",
                {"bridge": self.bridge, "reason": str(exc)},
            ) from exc
        except OSError as exc:
            raise CliError("bridge_unreachable", "Could not reach Hue bridge", {"bridge": self.bridge, "reason": str(exc)}) from exc
        finally:
            conn.close()

        if response.status == 401 or response.status == 403:
            raise CliError("authentication_failed", "Hue bridge rejected the application key", {"bridge": self.bridge})

        try:
            parsed = json.loads(raw.decode("utf-8") or "{}")
        except json.JSONDecodeError as exc:
            raise CliError(
                "unexpected_response",
                "Hue bridge returned invalid JSON",
                {"status": response.status, "body": clamp_detail(raw.decode("utf-8", errors="replace"))},
            ) from exc
        if response.status >= 400:
            raise CliError(
                "api_rejected_request",
                "Hue bridge rejected the request",
                {"status": response.status, "response": clamp_detail(parsed)},
            )
        return parsed


def pick_service_id(resource: dict[str, Any], service_type: str) -> str | None:
    for service in resource.get("services", []):
        if service.get("rtype") == service_type:
            return service.get("rid")
    return None


def build_inventory(resources: dict[str, list[dict[str, Any]]]) -> dict[str, Any]:
    devices = resources.get("device") or []
    lights = resources.get("light") or []
    rooms = resources.get("room") or []
    scenes = resources.get("scene") or []
    grouped_lights = resources.get("grouped_light") or []

    devices_by_id = {device["id"]: device for device in devices}
    lights_by_id = {light["id"]: light for light in lights}
    grouped_by_id = {grouped["id"]: grouped for grouped in grouped_lights}

    device_to_light_ids: dict[str, list[str]] = {}
    for device in devices:
        light_ids = [service["rid"] for service in device.get("services", []) if service.get("rtype") == "light"]
        device_to_light_ids[device["id"]] = light_ids

    room_light_ids: dict[str, list[str]] = {}
    for room in rooms:
        resolved_light_ids: list[str] = []
        for child in room.get("children", []):
            rid = child.get("rid")
            rtype = child.get("rtype")
            if rtype == "light" and rid in lights_by_id:
                resolved_light_ids.append(rid)
            elif rtype == "device":
                resolved_light_ids.extend(device_to_light_ids.get(rid, []))
        room_light_ids[room["id"]] = list(dict.fromkeys(resolved_light_ids))

    light_to_room_ids: dict[str, list[str]] = {}
    for room_id, light_ids in room_light_ids.items():
        for light_id in light_ids:
            light_to_room_ids.setdefault(light_id, []).append(room_id)

    room_scenes: dict[str, list[dict[str, Any]]] = {}
    for scene in scenes:
        group = scene.get("group") or {}
        group_id = group.get("rid")
        if group_id:
            room_scenes.setdefault(group_id, []).append(scene)

    def light_name(light: dict[str, Any]) -> str:
        owner = light.get("owner") or {}
        device = devices_by_id.get(owner.get("rid", ""))
        return (
            (light.get("metadata") or {}).get("name")
            or ((device or {}).get("metadata") or {}).get("name")
            or light["id"]
        )

    room_names_by_id = {room["id"]: (room.get("metadata") or {}).get("name") or room["id"] for room in rooms}

    # Refs are derived from names, so rooms resolve first and then qualify the
    # lights and scenes that live inside them.
    room_stubs = [{"id": room["id"], "name": room_names_by_id[room["id"]]} for room in rooms]
    room_refs = assign_refs(room_stubs)

    def first_room_name(light_id: str) -> str | None:
        ids = light_to_room_ids.get(light_id, [])
        return room_names_by_id.get(ids[0]) if ids else None

    light_stubs = [{"id": light["id"], "name": light_name(light)} for light in lights]
    light_refs = assign_refs(light_stubs, qualifier=lambda stub: first_room_name(stub["id"]))

    scene_stubs = [
        {"id": scene["id"], "name": (scene.get("metadata") or {}).get("name") or scene["id"]}
        for scene in scenes
    ]
    scene_room_name = {
        scene["id"]: room_names_by_id.get(((scene.get("group") or {}).get("rid")) or "")
        for scene in scenes
    }
    scene_refs = assign_refs(scene_stubs, qualifier=lambda stub: scene_room_name.get(stub["id"]))

    def summarize_light(light: dict[str, Any]) -> dict[str, Any]:
        room_ids = light_to_room_ids.get(light["id"], [])
        owner = light.get("owner") or {}
        return {
            "id": light["id"],
            "ref": light_refs.get(light["id"], slugify(light_name(light))),
            "name": light_name(light),
            "on": ((light.get("on") or {}).get("on")),
            "brightness": ((light.get("dimming") or {}).get("brightness")),
            "mirek": ((light.get("color_temperature") or {}).get("mirek")),
            "mirek_valid": ((light.get("color_temperature") or {}).get("mirek_valid")),
            "xy": ((light.get("color") or {}).get("xy")),
            "room_ids": room_ids,
            "room_names": [room_names_by_id[room_id] for room_id in room_ids if room_id in room_names_by_id],
            "room_refs": [room_refs[room_id] for room_id in room_ids if room_id in room_refs],
            "device_id": owner.get("rid"),
            "raw": light,
        }

    def summarize_scene(scene: dict[str, Any]) -> dict[str, Any]:
        group = scene.get("group") or {}
        room_id = group.get("rid")
        return {
            "id": scene["id"],
            "ref": scene_refs.get(scene["id"], slugify((scene.get("metadata") or {}).get("name") or scene["id"])),
            "name": (scene.get("metadata") or {}).get("name") or scene["id"],
            "room_id": room_id,
            "room_ref": room_refs.get(room_id or ""),
            "room_name": room_names_by_id.get(room_id or ""),
            "status": scene.get("status"),
            "speed": scene.get("speed"),
            "auto_dynamic": scene.get("auto_dynamic"),
            "raw": scene,
        }

    def summarize_room(room: dict[str, Any]) -> dict[str, Any]:
        member_lights = [
            summarize_light(lights_by_id[light_id])
            for light_id in room_light_ids.get(room["id"], [])
            if light_id in lights_by_id
        ]
        grouped_light_id = pick_service_id(room, "grouped_light")
        grouped_light = grouped_by_id.get(grouped_light_id) if grouped_light_id else None
        return {
            "id": room["id"],
            "ref": room_refs.get(room["id"], slugify(room_names_by_id[room["id"]])),
            "name": room_names_by_id[room["id"]],
            "grouped_light_id": grouped_light_id,
            "grouped_on": ((grouped_light or {}).get("on") or {}).get("on"),
            "lights": member_lights,
            "scenes": [summarize_scene(scene) for scene in room_scenes.get(room["id"], [])],
            "raw": room,
        }

    return {
        "lights": [summarize_light(light) for light in lights],
        "rooms": [summarize_room(room) for room in rooms],
        "scenes": [summarize_scene(scene) for scene in scenes],
    }


# --- views -------------------------------------------------------------------
#
# Every read path projects an internal record down to the smallest shape that
# still answers the question. Detail and raw are opt-in, and raw is only
# reachable with a selector, so an unbounded raw list cannot be requested.


def ref_of(record: dict[str, Any]) -> dict[str, Any]:
    return {"ref": record["ref"], "name": record["name"]}


def view_light(record: dict[str, Any], detail: bool = False, raw: bool = False) -> dict[str, Any]:
    brightness = record.get("brightness")
    view = {
        "ref": record["ref"],
        "name": record["name"],
        "on": record.get("on"),
        "brightness": round(brightness) if isinstance(brightness, (int, float)) else None,
        "room": (record.get("room_refs") or [None])[0],
    }
    if detail or raw:
        view.update(
            {
                "uuid": record["id"],
                "brightness_exact": record.get("brightness"),
                "mirek": record.get("mirek"),
                "mirek_valid": record.get("mirek_valid"),
                "xy": record.get("xy"),
                "rooms": record.get("room_refs"),
                "device_uuid": record.get("device_id"),
            }
        )
    if raw:
        view["raw"] = record.get("raw")
    return view


def view_scene(record: dict[str, Any], detail: bool = False, raw: bool = False) -> dict[str, Any]:
    view = {
        "ref": record["ref"],
        "name": record["name"],
        "room": record.get("room_ref"),
    }
    if detail or raw:
        view.update(
            {
                "uuid": record["id"],
                "room_name": record.get("room_name"),
                "status": record.get("status"),
                "speed": record.get("speed"),
                "auto_dynamic": record.get("auto_dynamic"),
            }
        )
    if raw:
        view["raw"] = record.get("raw")
    return view


def view_room(
    record: dict[str, Any],
    detail: bool = False,
    raw: bool = False,
    with_lights: bool = False,
    with_scenes: bool = False,
) -> dict[str, Any]:
    view = {
        "ref": record["ref"],
        "name": record["name"],
        "on": record.get("grouped_on"),
        "light_count": len(record.get("lights") or []),
    }
    if detail or raw:
        view.update(
            {
                "uuid": record["id"],
                "grouped_light_uuid": record.get("grouped_light_id"),
                "scene_count": len(record.get("scenes") or []),
            }
        )
    if with_lights:
        view["lights"] = [view_light(light, detail=detail) for light in record.get("lights") or []]
    if with_scenes:
        view["scenes"] = [view_scene(scene, detail=detail) for scene in record.get("scenes") or []]
    if raw:
        view["raw"] = record.get("raw")
    return view


# --- response budget ---------------------------------------------------------


def list_result(
    key: str,
    items: list[dict[str, Any]],
    total: int | None = None,
    extra: dict[str, Any] | None = None,
) -> dict[str, Any]:
    result = dict(extra or {})
    result[key] = items
    result["count"] = len(items)
    result["total"] = len(items) if total is None else total
    result["truncated"] = False
    return result


def enforce_budget(payload: dict[str, Any], list_key: str, max_bytes: int) -> dict[str, Any]:
    """Trim a list result until the encoded response fits the byte budget.

    The caller is told in-band that the list is short, which is the difference
    between a wrong answer and a recoverable one. That notice is never dropped
    to save space, so the envelope plus the notice is a floor: budgets smaller
    than roughly 400 bytes are met as closely as possible rather than exactly.
    """
    if max_bytes <= 0:
        return payload
    if len(encode(payload)) <= max_bytes:
        return payload

    result = payload.get("result") or {}
    items = result.get(list_key)
    if not isinstance(items, list) or not items:
        return payload

    total = result.get("total", len(items))

    def attempt(count: int) -> dict[str, Any]:
        trimmed = dict(result)
        trimmed[list_key] = items[:count]
        trimmed["count"] = count
        trimmed["total"] = total
        trimmed["truncated"] = True
        trimmed["hint"] = (
            f"Truncated to {count} of {total} {list_key} by the {max_bytes}B budget. "
            f"Narrow with a selector, --room, --on, or --limit; or raise --max-bytes."
        )
        return {**payload, "result": trimmed}

    low, high, best = 0, len(items) - 1, 0
    while low <= high:
        mid = (low + high) // 2
        if len(encode(attempt(mid))) <= max_bytes:
            best = mid
            low = mid + 1
        else:
            high = mid - 1
    return attempt(best)


# --- selectors ---------------------------------------------------------------


def resolve_selector(
    items: list[dict[str, Any]],
    resource_type: str,
    item_id: str | None = None,
    item_name: str | None = None,
    item_ref: str | None = None,
) -> dict[str, Any]:
    provided = [value for value in (item_id, item_name, item_ref) if value]
    if len(provided) > 1:
        raise CliError("invalid_arguments", f"Provide only one of --ref, --name, or --id for {resource_type}")
    if not provided:
        raise CliError("selector_required", f"{resource_type} selector required", {"resource_type": resource_type})

    if item_ref:
        matched = [item for item in items if item.get("ref") == item_ref.strip().casefold()]
        if not matched:
            raise CliError(
                "resource_not_found",
                f"No {resource_type} matched the ref",
                {"ref": item_ref, "hint": f"Refs are derived from names; list them with `get {resource_type} --all`."},
            )
    elif item_id:
        matched = [item for item in items if item["id"] == item_id]
        if not matched:
            raise CliError("resource_not_found", f"No {resource_type} matched the selector", {"id": item_id})
    else:
        normalized_name = normalize_name(item_name or "")
        matched = [item for item in items if normalize_name(item.get("name", "")) == normalized_name]
        if not matched:
            raise CliError("resource_not_found", f"No {resource_type} matched the selector", {"name": item_name})

    if len(matched) > 1:
        raise CliError(
            "ambiguous_match",
            f"Multiple {resource_type}s matched the selector",
            {
                "name": item_name,
                "matches": [ref_of(item) for item in matched],
                "hint": "Select one with --ref, which is unique.",
            },
        )
    return matched[0]


def resolve_optional_room_filter(rooms: list[dict[str, Any]], room: str | None) -> dict[str, Any] | None:
    """Resolve a --room value, which accepts a ref, a name, or a uuid."""
    if not room:
        return None
    value = room.strip()
    by_ref = [item for item in rooms if item.get("ref") == value.casefold()]
    if by_ref:
        return by_ref[0]
    by_id = [item for item in rooms if item["id"] == value]
    if by_id:
        return by_id[0]
    return resolve_selector(rooms, "room", item_name=value)


def resolve_light_targets(
    items: list[dict[str, Any]],
    ids: list[str] | None = None,
    names: list[str] | None = None,
    refs: list[str] | None = None,
    select_all: bool = False,
) -> list[dict[str, Any]]:
    ids, names, refs = ids or [], names or [], refs or []
    if select_all:
        if ids or names or refs:
            raise CliError("invalid_arguments", "--all cannot be combined with --ref, --name, or --id")
        if not items:
            raise CliError("resource_not_found", "No lights are available on this bridge")
        return list(items)
    if not ids and not names and not refs:
        raise CliError(
            "selector_required",
            "At least one light selector is required",
            {"resource_type": "light", "hint": "Use --ref/--name/--id, or --all to target every light."},
        )

    resolved: list[dict[str, Any]] = []
    seen_ids: set[str] = set()

    def take(light: dict[str, Any]) -> None:
        if light["id"] not in seen_ids:
            resolved.append(light)
            seen_ids.add(light["id"])

    for value in refs:
        take(resolve_selector(items, "light", item_ref=value))
    for value in ids:
        take(resolve_selector(items, "light", item_id=value))
    for value in names:
        take(resolve_selector(items, "light", item_name=value))

    return resolved


def partition_excluded(
    lights: list[dict[str, Any]], exclude_values: list[str], scope: str
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """Split a candidate light list into targets and exclusions.

    Exclusions resolve against the whole candidate set, so `--all --exclude`
    works the same way whether the scope is one room or every room.
    """
    if not exclude_values:
        return (lights, [])

    excluded: list[dict[str, Any]] = []
    excluded_ids: set[str] = set()
    for value in exclude_values:
        needle = value.strip()
        match = next((light for light in lights if light.get("ref") == needle.casefold()), None)
        if match is None:
            match = next((light for light in lights if light["id"] == needle), None)
        if match is None:
            name_matches = [light for light in lights if normalize_name(light["name"]) == normalize_name(needle)]
            if not name_matches:
                raise CliError(
                    "resource_not_found",
                    "Excluded light not found in scope",
                    {"exclude": value, "scope": scope},
                )
            if len(name_matches) > 1:
                raise CliError(
                    "ambiguous_match",
                    "Excluded light name matched multiple lights",
                    {
                        "exclude": value,
                        "scope": scope,
                        "matches": [ref_of(light) for light in name_matches],
                        "hint": "Exclude by --ref, which is unique.",
                    },
                )
            match = name_matches[0]
        if match["id"] not in excluded_ids:
            excluded.append(match)
            excluded_ids.add(match["id"])

    targets = [light for light in lights if light["id"] not in excluded_ids]
    return (targets, excluded)


def lights_in_all_rooms(inventory: dict[str, Any]) -> list[dict[str, Any]]:
    collected: list[dict[str, Any]] = []
    seen: set[str] = set()
    for room in inventory["rooms"]:
        for light in room["lights"]:
            if light["id"] not in seen:
                collected.append(light)
                seen.add(light["id"])
    return collected


# --- colour and payloads -----------------------------------------------------


def parse_color(args: argparse.Namespace) -> dict[str, Any]:
    if args.xy and args.hex:
        raise CliError("invalid_arguments", "Provide either --xy or --hex, not both")
    if args.xy:
        x, y = parse_xy(args.xy)
        return {"color": {"xy": {"x": x, "y": y}}}
    if args.hex:
        x, y = hex_to_xy(args.hex)
        return {"color": {"xy": {"x": x, "y": y}}}
    return {}


def hex_to_xy(value: Any) -> tuple[float, float]:
    if not isinstance(value, str):
        raise CliError("invalid_arguments", "hex color must be a string", {"value": value})
    normalized = value.strip().lower()
    normalized = CSS_COLOR_NAMES.get(normalized, normalized)
    if normalized.startswith("#"):
        normalized = normalized[1:]
    if not re.fullmatch(r"[0-9a-f]{6}", normalized):
        raise CliError("invalid_arguments", "hex color must be #RRGGBB or a supported color name", {"value": value})
    red = int(normalized[0:2], 16) / 255.0
    green = int(normalized[2:4], 16) / 255.0
    blue = int(normalized[4:6], 16) / 255.0

    def gamma_correct(channel: float) -> float:
        if channel > 0.04045:
            return ((channel + 0.055) / 1.055) ** 2.4
        return channel / 12.92

    red = gamma_correct(red)
    green = gamma_correct(green)
    blue = gamma_correct(blue)

    x_val = red * 0.664511 + green * 0.154324 + blue * 0.162028
    y_val = red * 0.283881 + green * 0.668433 + blue * 0.047685
    z_val = red * 0.000088 + green * 0.07231 + blue * 0.986039
    total = x_val + y_val + z_val
    if total == 0:
        raise CliError("invalid_arguments", "color conversion failed", {"value": value})
    return (round(x_val / total, 6), round(y_val / total, 6))


def build_light_payload(args: argparse.Namespace) -> dict[str, Any]:
    return build_light_payload_from_values(
        on=args.on,
        brightness=args.brightness,
        mirek=args.mirek,
        xy=args.xy,
        hex_value=args.hex,
    )


def build_light_payload_from_values(
    *,
    on: bool | None = None,
    brightness: float | int | None = None,
    mirek: int | None = None,
    xy: list[Any] | tuple[Any, Any] | None = None,
    hex_value: str | None = None,
) -> dict[str, Any]:
    payload: dict[str, Any] = {}
    if on is not None:
        payload["on"] = {"on": parse_bool(on)}
    if brightness is not None:
        payload["dimming"] = {"brightness": parse_brightness(brightness)}
    if mirek is not None:
        payload["color_temperature"] = {"mirek": parse_mirek(mirek)}
    color_args = argparse.Namespace(xy=xy, hex=hex_value)
    payload.update(parse_color(color_args))
    if not payload:
        raise CliError(
            "invalid_arguments",
            "At least one state field is required",
            {"allowed_fields": ["on", "brightness", "mirek", "xy", "hex"]},
        )
    return payload


def build_scene_payload(action: str = "active", duration_ms: int | None = None) -> dict[str, Any]:
    if action not in {"active", "dynamic_palette", "static"}:
        raise CliError("invalid_arguments", "scene action must be one of: active, dynamic_palette, static")
    payload: dict[str, Any] = {"recall": {"action": action}}
    if duration_ms is not None:
        if isinstance(duration_ms, bool) or not isinstance(duration_ms, int) or duration_ms < 0:
            raise CliError("invalid_arguments", "duration_ms must be a non-negative integer", {"value": duration_ms})
        payload["recall"]["duration"] = duration_ms
    return payload


# --- inventory fetching ------------------------------------------------------


def fetch_inventory(client: HueClient, *, scenes: bool = True, grouped: bool = True) -> dict[str, Any]:
    """Fetch only the resource types this invocation actually needs.

    Devices, lights and rooms are always required because refs and room
    membership depend on them. Scenes are the largest collection on a typical
    bridge, so they are skipped unless the command touches scenes.
    """
    resources = {
        "device": (client.request("GET", "resource/device").get("data") or []),
        "light": (client.request("GET", "resource/light").get("data") or []),
        "room": (client.request("GET", "resource/room").get("data") or []),
        "scene": (client.request("GET", "resource/scene").get("data") or []) if scenes else [],
        "grouped_light": (client.request("GET", "resource/grouped_light").get("data") or []) if grouped else [],
    }
    return build_inventory(resources)


def plan_fetch(args: argparse.Namespace, doc: dict[str, Any] | None) -> dict[str, bool]:
    if doc is not None:
        return {"scenes": doc.get("action") == "set_scene", "grouped": doc.get("action") == "set_room"}
    resource = getattr(args, "resource", None)
    command = getattr(args, "command", None)
    if resource == "scene":
        return {"scenes": True, "grouped": False}
    if resource == "room":
        needs_scenes = bool(getattr(args, "with_scenes", False) or getattr(args, "detail", False) or getattr(args, "raw", False))
        return {"scenes": needs_scenes, "grouped": command == "get"}
    return {"scenes": False, "grouped": False}


